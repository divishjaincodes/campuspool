# Supabase Configuration
# Replace with your Supabase Project URL from: Supabase Dashboard -> Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Safe for frontend)
VITE_SUPABASE_ANON_KEY=your_publishable_key_here

# Supabase Secret / Service Role Key (Keep private! Do NOT prefix with VITE_)
SUPABASE_SECRET_KEY=your_secret_key_here
